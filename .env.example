# Copy this file to .env and fill in at least ONE key. Never commit .env or share a key.
# With both keys set, the page header lets you switch provider and model.

# ---- Which provider is selected when the page opens (gemini or openai). Optional.
AI_PROVIDER=gemini

# ---- Gemini (Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=AQ.Ab8RN6IuAYlXGWVkZkfYsRD-x3d_lJIBKrGaaF8x5fb9u2tmsw
GEMINI_MODEL=gemini-3.8-flash
# Models listed in the picker if the live list cannot be fetched (comma separated). Optional.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash
# Tried once if the main model stays overloaded (503) after automatic retries. Optional.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Use "interactions" if "generateContent" is rejected for your key. Optional.
GEMINI_API_STYLE=generateContent

# ---- OpenAI (platform.openai.com)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-5-mini
OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1
# Any OpenAI-compatible service works too (OpenRouter, Groq, Azure, local Ollama ...):
# set the base URL here and use that service's key and model names.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Older compatible servers may need: OPENAI_TOKEN_PARAM=max_tokens

# ---- Shared. Optional.
PORT=3000
RATE_LIMIT_MAX=30
# AI_RETRY_DELAY_MS=2000
