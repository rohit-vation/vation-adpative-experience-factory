# Copy this file to .env. Runtime generation always uses a provider API.
# There is no demo fallback or API enable/disable switch. Keep credentials out of source control.
# Configure at least one supported provider key before generating results.

AI_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_API_STYLE=generateContent

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1
# For an OpenAI-compatible provider, set its base URL and matching key/model:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TOKEN_PARAM=max_tokens

# Standard server and logging settings
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_MAX=30
AI_RETRY_DELAY_MS=2000
LOG_LEVEL=INFO
LOG_TO_FILE=true
