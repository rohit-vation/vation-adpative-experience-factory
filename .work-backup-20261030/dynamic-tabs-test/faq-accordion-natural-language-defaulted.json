                                                                       "code":  "\u003cdiv class=\"cmp-faq\"\u003e\u003cdiv class=\"cmp-faq__items\" data-sly-list.group=\"${resource.children}\"\u003e\u003csly data-sly-test=\"${group.name == \u0027items\u0027}\"\u003e\u003cdiv class=\"cmp-faq__item\" data-sly-list.item=\"${group.children}\"\u003e\u003cbutton type=\"button\" class=\"cmp-faq__question\" aria-expanded=\"false\" aria-controls=\"answer-${itemList.index}\"\u003e${item.valueMap.question}\u003c/button\u003e\u003cdiv id=\"answer-${itemList.index}\" class=\"cmp-faq__answer\" hidden\u003e${item.valueMap.answer @ context=\u0027html\u0027}\u003c/div\u003e\u003c/div\u003e\u003c/sly\u003e\u003c/div\u003e\u003c/div\u003e"
                                                                   },
                                                                   {
                                                                       "name":  "apps/site/components/fAQAccordion/clientlib/js/fAQAccordion.js",
                                                                       "lang":  "js",
                                                                       "code":  "document.querySelectorAll(\u0027.cmp-faq\u0027).forEach(faq =\u003e { const buttons = faq.querySelectorAll(\u0027.cmp-faq__question\u0027); buttons.forEach(btn =\u003e { btn.addEventListener(\u0027click\u0027, () =\u003e { const isOpen = btn.getAttribute(\u0027aria-expanded\u0027) === \u0027true\u0027; buttons.forEach(b =\u003e { b.setAttribute(\u0027aria-expanded\u0027, \u0027false\u0027); b.nextElementSibling.hidden = true; }); if (!isOpen) { btn.setAttribute(\u0027aria-expanded\u0027, \u0027true\u0027); btn.nextElementSibling.hidden = false; } }); }); });"
                                                                   }
