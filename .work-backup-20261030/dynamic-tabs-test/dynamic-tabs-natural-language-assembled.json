                                                                       "code":  "\u003csly data-sly-use.clientlib=\"/libs/granite/sightly/templates/clientlib.html\"/\u003e\n\u003csly /\u003e\n\u003csly /\u003e\n\u003csly data-sly-use.model=\"com.example.site.core.models.DynamicTabsNaturalLanguageModel\"/\u003e\n\u003csly data-sly-call=\"${clientlib.css @ categories=\u0027scotia.components.dynamicTabs\u0027}\"\u003e\u003c/sly\u003e\n\u003csly data-sly-call=\"${clientlib.js @ categories=\u0027scotia.components.dynamicTabs\u0027}\"\u003e\u003c/sly\u003e\n\u003cdiv class=\"cmp-dynamic-tabs-natural-language\" data-cmp-is=\"tabs\" data-sly-test=\"${model.tabs}\"\u003e\n  \u003cdiv class=\"cmp-dynamic-tabs-natural-language__tablist\" role=\"tablist\" aria-label=\"Content tabs\"\u003e\n    \u003csly data-sly-list.tab=\"${model.tabs}\"\u003e\n      \u003cbutton type=\"button\" class=\"cmp-dynamic-tabs-natural-language__tab\" role=\"tab\" id=\"${resource.path}-tab-${tabList.index}\" aria-controls=\"${resource.path}-panel-${tabList.index}\" aria-selected=\"${tabList.first ? \u0027true\u0027 : \u0027false\u0027}\" tabindex=\"${tabList.first ? \u00270\u0027 : \u0027-1\u0027}\"\u003e${tab.valueMap.title}\u003c/button\u003e\n    \u003c/sly\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"cmp-dynamic-tabs-natural-language__panels\"\u003e\n    \u003csly data-sly-list.tab=\"${model.tabs}\"\u003e\n      \u003csection class=\"cmp-dynamic-tabs-natural-language__tabpanel\" role=\"tabpanel\" id=\"${resource.path}-panel-${tabList.index}\" aria-labelledby=\"${resource.path}-tab-${tabList.index}\" tabindex=\"0\" data-sly-attribute.hidden=\"${!tabList.first}\"\u003e\n        \u003cdiv class=\"cmp-dynamic-tabs-natural-language__panel-content\"\u003e${tab.valueMap.content @ context=\u0027html\u0027}\u003c/div\u003e\n      \u003c/section\u003e\n    \u003c/sly\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"
