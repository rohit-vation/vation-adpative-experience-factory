                                                                   {
                                                                       "name":  "apps/site/components/fAQAccordion/fAQAccordion.html",
                                                                       "lang":  "htl",
                                                                       "code":  "\u003csly data-sly-use.clientlib=\"/libs/granite/sightly/templates/clientlib.html\"/\u003e\n\u003csly /\u003e\n\u003csly /\u003e\n\u003csly data-sly-use.model=\"com.example.site.core.models.FAQAccordionModel\"/\u003e\n\u003csly data-sly-call=\"${clientlib.css @ categories=\u0027site.components.faqAccordion\u0027}\"\u003e\u003c/sly\u003e\n\u003csly data-sly-call=\"${clientlib.js @ categories=\u0027site.components.faqAccordion\u0027}\"\u003e\u003c/sly\u003e\n\u003cdiv class=\"cmp-f-aqaccordion\" data-cmp-is=\"accordion\" data-sly-test=\"${model.items}\"\u003e\n  \u003cdiv class=\"cmp-f-aqaccordion__items\" data-sly-list.item=\"${model.items}\"\u003e\n    \u003cdiv class=\"cmp-f-aqaccordion__item\"\u003e\n      \u003ch3 class=\"cmp-f-aqaccordion__heading\"\u003e\n        \u003cbutton type=\"button\" class=\"cmp-f-aqaccordion__trigger\" id=\"${resource.path}-accordion-trigger-${itemList.index}\" aria-controls=\"${resource.path}-accordion-panel-${itemList.index}\" aria-expanded=\"false\"\u003e${item.valueMap.question}\u003c/button\u003e\n      \u003c/h3\u003e\n      \u003cdiv class=\"cmp-f-aqaccordion__panel\" id=\"${resource.path}-accordion-panel-${itemList.index}\" role=\"region\" aria-labelledby=\"${resource.path}-accordion-trigger-${itemList.index}\" hidden\u003e\n        \u003cdiv class=\"cmp-f-aqaccordion__answer\"\u003e${item.valueMap.answer @ context=\u0027html\u0027}\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"
