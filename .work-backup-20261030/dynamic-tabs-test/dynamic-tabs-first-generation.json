{
    "data":  {
                 "component":  {
                                   "name":  "Dynamic Tabs",
                                   "cms":  "aem",
                                   "summary":  "A fully accessible, multifield-based tabbed component with show/hide functionality."
                               },
                 "design":  {
                                "a11y":  [
                                             "Follows WAI-ARIA Tabs pattern (role=tablist, role=tab, role=tabpanel).",
                                             "Keyboard navigation support: Arrow keys to switch tabs.",
                                             "Appropriate aria-selected and aria-controls attributes."
                                         ]
                            },
