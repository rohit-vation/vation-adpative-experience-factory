                                             "title":  "AEM Composite Multifield Pattern",
                                             "appliesTo":  "AEM",
                                             "rule":  "Use relative naming inside multifield items.",
                                             "reason":  "Ensures standard Granite UI composite storage.",
                                             "validation":  "Check JCR node structure for named container nodes.",
                                             "examplePattern":  "\u003cfield name=\u0027./title\u0027 /\u003e inside a composite container."
                                         }
