                                                                       "name":  "tabs.html",
                                                                       "lang":  "html",
                                                                       "code":  "\u003cdiv class=\u0027dynamic-tabs\u0027 data-sly-use.model=\"com.example.site.core.models.DynamicTabsModel\"\u003e\u003cul role=\u0027tablist\u0027\u003e\u003csly data-sly-list.tab=\u0027${model.tabs}\u0027\u003e\u003cli role=\u0027tab\u0027 id=\u0027tab-${tabList.index}\u0027 aria-controls=\u0027panel-${tabList.index}\u0027\u003e${tab.tabTitle}\u003c/li\u003e\u003c/sly\u003e\u003c/ul\u003e\u003csly data-sly-list.tab=\u0027${model.tabs}\u0027\u003e\u003cdiv role=\u0027tabpanel\u0027 id=\u0027panel-${tabList.index}\u0027 aria-labelledby=\u0027tab-${tabList.index}\u0027\u003e${tab.tabContent @ context=\u0027html\u0027}\u003c/div\u003e\u003c/sly\u003e\u003c/div\u003e"
                                                                   },
                                                                   {
                                                                       "name":  "clientlib/js/tabs.js",
                                                                       "lang":  "js",
                                                                       "code":  "document.addEventListener(\u0027DOMContentLoaded\u0027, () =\u003e { document.querySelectorAll(\u0027.dynamic-tabs\u0027).forEach(tabs =\u003e { const items = tabs.querySelectorAll(\u0027[role=\"tab\"]\u0027); items.forEach((tab, i) =\u003e { tab.addEventListener(\u0027click\u0027, () =\u003e { tabs.querySelectorAll(\u0027[role=\"tabpanel\"]\u0027).forEach((p, idx) =\u003e p.style.display = idx === i ? \u0027block\u0027 : \u0027none\u0027); }); }); }); });"
                                                                   },
                                                                   {
                                                                       "name":  "clientlib/css/tabs.css",
                                                                       "lang":  "css",
                                                                       "code":  ".dynamic-tabs [role=\u0027tabpanel\u0027] { display: none; } .dynamic-tabs [role=\u0027tabpanel\u0027]:first-child { display: block; }"
                                                                   }
