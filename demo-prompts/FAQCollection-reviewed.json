                                                          "code":  "\u003csly data-sly-use.clientlib=\"/libs/granite/sightly/templates/clientlib.html\"/\u003e\n\u003csly data-sly-call=\"${clientlib.css @ categories=\u0027faq.components.collection\u0027}\"\u003e\u003c/sly\u003e\n\u003csly data-sly-call=\"${clientlib.js @ categories=\u0027faq.components.collection\u0027}\"\u003e\u003c/sly\u003e\n\u003cdiv class=\"cmp-faqCollection\" data-cmp-is=\"faq-accordion\" data-accordion-mode=\"${properties.allowMultipleOpen ? \u0027multiple\u0027 : \u0027single\u0027}\"\u003e\n  \u003cdiv class=\"cmp-faqCollection__items\" data-sly-list.item=\"${resource.getChildren.questions}\"\u003e\n    \u003csection class=\"cmp-faqCollection__item\"\u003e\n      \u003ch3 class=\"cmp-faqCollection__heading\"\u003e\u003cbutton type=\"button\" class=\"cmp-faqCollection__trigger\" id=\"faq-${resource.name}-${itemList.index}-trigger\" aria-controls=\"faq-${resource.name}-${itemList.index}-panel\" aria-expanded=\"false\"\u003e${item.valueMap.question}\u003c/button\u003e\u003c/h3\u003e\n      \u003cdiv class=\"cmp-faqCollection__panel\" id=\"faq-${resource.name}-${itemList.index}-panel\" role=\"region\" aria-labelledby=\"faq-${resource.name}-${itemList.index}-trigger\" hidden\u003e\u003cdiv class=\"cmp-faqCollection__answer\"\u003e${item.valueMap.answer @ context=\u0027html\u0027}\u003c/div\u003e\u003c/div\u003e\n    \u003c/section\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"
