                                                          "lang":  "css",
                                                          "code":  ".cmp-faqCollection__trigger{width:100%;text-align:left;padding:1rem;cursor:pointer}.cmp-faqCollection__trigger:focus-visible{outline:2px solid currentColor;outline-offset:3px}.cmp-faqCollection__panel[hidden]{display:none!important}.cmp-faqCollection__panel{padding:1rem}"
                                                      },
                                                      {
                                                          "name":  "apps/site/components/fAQCollection/clientlib/js.txt",
                                                          "lang":  "txt",
                                                          "code":  "#base=js\nfAQCollection.js\n"
                                                      },
                                                      {
                                                          "name":  "apps/site/components/fAQCollection/clientlib/js/fAQCollection.js",
                                                          "lang":  "js",
                                                          "code":  "(function(){\u0027use strict\u0027;var selector=\u0027[data-cmp-is=\"faq-accordion\"]\u0027;function init(root){if(root.dataset.faqReady)return;root.dataset.faqReady=\u0027true\u0027;var triggers=[...root.querySelectorAll(\u0027[aria-controls]\u0027)];function panel(t){return root.querySelector(\u0027#\u0027+CSS.escape(t.getAttribute(\u0027aria-controls\u0027)))}triggers.forEach(function(t){t.addEventListener(\u0027click\u0027,function(){var expanded=t.getAttribute(\u0027aria-expanded\u0027)===\u0027true\u0027;var single=root.dataset.accordionMode!==\u0027multiple\u0027;if(single||expanded)triggers.forEach(function(x){x.setAttribute(\u0027aria-expanded\u0027,\u0027false\u0027);var p=panel(x);if(p)p.hidden=true});if(!expanded){t.setAttribute(\u0027aria-expanded\u0027,\u0027true\u0027);var p=panel(t);if(p)p.hidden=false}});t.addEventListener(\u0027keydown\u0027,function(e){if(e.key===\u0027Enter\u0027||e.key===\u0027 \u0027){e.preventDefault();t.click()}})});}function run(){document.querySelectorAll(selector).forEach(init)}if(document.readyState===\u0027loading\u0027)document.addEventListener(\u0027DOMContentLoaded\u0027,run);else run();})();"
                                                      }
