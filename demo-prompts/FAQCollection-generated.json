                                   "name":  "FAQ Collection",
                                   "cms":  "aem",
                                   "summary":  "An accessible, expandable FAQ collection component with single/multiple open behavior and rich text answers."
                               },
                 "design":  {
                                "a11y":  [
                                             "WAI-ARIA accordion pattern (button controls with aria-expanded/aria-controls)",
                                             "Keyboard support: Space/Enter for toggle, Tab for focus navigation",
                                             "Semantic markup using details/summary or button/div regions"
                                         ]
                            },
                 "ruleSuggestions":  [
                                         {
                                             "title":  "Accessible Accordion Pattern",
                                             "appliesTo":  "FAQ Collection",
                                             "rule":  "Use role=\u0027region\u0027 for panel and aria-controls for trigger",
                                             "reason":  "Improves screen reader navigation in nested structures",
                                             "validation":  "Check aria-expanded state changes on click",
                                             "examplePattern":  "\u003cbutton aria-expanded=\u0027false\u0027 aria-controls=\u0027id\u0027\u003e...\u003c/button\u003e\u003cdiv id=\u0027id\u0027 hidden\u003e...\u003c/div\u003e"
