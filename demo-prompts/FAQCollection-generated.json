                                                                       "name":  "apps/site/components/fAQCollection/clientlib/css/fAQCollection.css",
                                                                       "lang":  "css",
                                                                       "code":  ".cmp-f-aqcollection { width: 100%; }\n.cmp-f-aqcollection__item { border-bottom: 1px solid var(--accordion-border-color, currentColor); }\n.cmp-f-aqcollection__heading { margin: 0; }\n.cmp-f-aqcollection__trigger { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 1rem; border: 0; background: transparent; color: inherit; font: inherit; font-weight: 600; text-align: left; cursor: pointer; }\n.cmp-f-aqcollection__trigger[aria-expanded=\"true\"] { color: var(--accordion-active-color, currentColor); }\n.cmp-f-aqcollection__trigger:focus-visible { outline: 2px solid var(--accordion-focus-color, currentColor); outline-offset: 3px; }\n.cmp-f-aqcollection__panel[hidden] { display: none !important; }\n.cmp-f-aqcollection__panel { padding: 0 1rem 1rem; }"
                                                                   },
                                                                   {
                                                                       "name":  "apps/site/components/fAQCollection/clientlib/js.txt",
                                                                       "lang":  "txt",
                                                                       "code":  "#base=js\nfAQCollection.js\n"
                                                                   },
                                                                   {
                                                                       "name":  "apps/site/components/fAQCollection/clientlib/js/fAQCollection.js",
                                                                       "lang":  "js",
                                                                       "code":  "(function () {\n  \u0027use strict\u0027;\n  var selector = \u0027[data-cmp-is=\"accordion\"]\u0027;\n  function owned(root, childSelector) {\n    return Array.prototype.filter.call(root.querySelectorAll(childSelector), function (node) { return node.closest(selector) === root; });\n  }\n  function initialize(root) {\n    if (root.getAttribute(\"data-accordion-initialized\") === \"true\") return;\n    root.setAttribute(\"data-accordion-initialized\", \"true\");\n    var triggers = owned(root, \u0027[aria-controls]\u0027);\n    var panels = owned(root, \u0027[role=\"region\"]\u0027);\n    if (!triggers.length || !panels.length) return;\n    function panelFor(trigger) {\n      var id = trigger.getAttribute(\"aria-controls\");\n      return panels.find(function (panel) { return panel.id === id; });\n    }\n    function close(trigger) {\n      var panel = panelFor(trigger);\n      trigger.setAttribute(\"aria-expanded\", \"false\");\n      if (panel) panel.hidden = true;\n    }\n    triggers.forEach(function (trigger) {\n      trigger.addEventListener(\"click\", function () {\n        var wasExpanded = trigger.getAttribute(\"aria-expanded\") === \"true\";\n        triggers.forEach(close);\n        if (!wasExpanded) {\n          var panel = panelFor(trigger);\n          trigger.setAttribute(\"aria-expanded\", \"true\");\n          if (panel) panel.hidden = false;\n        }\n      });\n    });\n  }\n  function initializeAll() { document.querySelectorAll(selector).forEach(initialize); }\n  if (document.readyState === \"loading\") document.addEventListener(\"DOMContentLoaded\", initializeAll); else initializeAll();\n})();"
                                                                   }
